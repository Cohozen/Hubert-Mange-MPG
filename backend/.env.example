# Base de données (SQLite en local). Pour Postgres : postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Secret pour signer les sessions applicatives (JWT). Générer une valeur aléatoire longue.
SESSION_SECRET="change-me-with-a-long-random-string"

# Clé de chiffrement des IBAN (AES-256-GCM). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NE JAMAIS la perdre (sinon IBAN illisibles) ni la committer.
ENCRYPTION_KEY=""

# Identifiants MPG de l'admin (toi) utilisés par le sync. NE PAS committer.
MPG_ADMIN_EMAIL=""
MPG_ADMIN_PASSWORD=""

# userId(s) MPG superadmin (séparés par des virgules). Te donne tous les droits au login.
# Ton userId : user_3482203
SUPERADMIN_MPG_USER_IDS="user_3482203"

# Auto-sync MPG. Désactiver avec AUTO_SYNC=false.
# Par défaut : lundi 08:30 Europe/Paris (résultats publiés vers 8h).
AUTO_SYNC="true"
SYNC_CRON="30 8 * * 1"
SYNC_TZ="Europe/Paris"

# Port de l'API
PORT=3001

# Origine autorisée pour le front (CORS)
FRONTEND_ORIGIN="http://localhost:5173"
