# Base de données.
#  - Local : SQLite (laisser tel quel).
#  - Prod (Railway) : connection string Supabase (Session pooler, IPv4, port 5432).
#    ex : postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="file:./dev.db"

# (Dev uniquement) Connection string de la PROD, utilisée par `npm run clone:prod` pour
# copier les données prod → base SQLite locale. Laisser vide en temps normal. NE PAS committer.
#   ex (Session pooler) : postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
PROD_DATABASE_URL=""

# Secret pour signer les sessions applicatives (JWT). Générer une valeur aléatoire longue.
SESSION_SECRET="change-me-with-a-long-random-string"

# Clé de chiffrement (AES-256-GCM) des IBAN ET des tokens MPG (access + refresh) capturés au
# login. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NE JAMAIS la perdre (sinon IBAN/tokens illisibles) ni la committer.
ENCRYPTION_KEY=""

# Identifiants MPG de l'admin (toi). Désormais requis UNIQUEMENT pour l'auto-sync (cron) et le
# CLI `npm run sync`. Le sync manuel et la découverte admin utilisent le token du superadmin
# connecté. NE PAS committer.
MPG_ADMIN_EMAIL=""
MPG_ADMIN_PASSWORD=""

# userId(s) MPG superadmin (séparés par des virgules). Te donne tous les droits au login.
# Ton userId : user_3482203
SUPERADMIN_MPG_USER_IDS="user_3482203"

# Auto-sync MPG. Désactiver avec AUTO_SYNC=false.
AUTO_SYNC="true"
SYNC_TZ="Europe/Paris"

# Déclenchement. `matchday` (défaut) : un tick régulier interroge le planner
# (src/sync/planner.ts), qui croise une grille de créneaux Ligue 1 avec l'état réel des
# journées en base — silencieux hors journée (trêve, intersaison), actif dès qu'une journée
# est en cours, y compris décalée en semaine. `cron` : repli sur SYNC_CRON.
# SYNC_MODE="matchday"
# SYNC_TICK_CRON="*/15 * * * *"

# Surcharge des créneaux « journée en cours » (heure locale SYNC_TZ). Une entrée = un jour +
# une heure. Vide ⇒ grille par défaut, calée sur les horaires L1 2026-2027 :
#   ven 22:45 · sam 19:15 · sam 22:45 · dim 17:00 · dim 19:15 · dim 22:45 · mar–jeu 20:30 et 23:15
# Les créneaux inconditionnels (lun 08:30 = run complet, autres jours 08:30 = run léger) ne
# sont pas surchargeables.
# SYNC_SLOTS="fri 22:45, sat 19:15, sat 22:45, sun 17:00, sun 19:15, sun 22:45"

# Utilisé UNIQUEMENT en SYNC_MODE=cron (ignoré, avec un avertissement, en mode matchday).
# SYNC_CRON="30 8 * * 1"

# Port de l'API (Railway fournit PORT automatiquement)
PORT=3001

# Origine autorisée pour le front (CORS). En prod : le domaine du front, ex
# https://www.ligue-hubert-mange.fr (front et API sont deux sous-domaines same-site).
FRONTEND_ORIGIN="http://localhost:5173"

# Cookie de session en Secure (HTTPS). Mettre "true" en prod (Railway).
COOKIE_SECURE="false"
