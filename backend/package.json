{
  "name": "mpg-enhanced-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:to-postgres": "node scripts/use-postgres.mjs",
    "build:prod": "npm run db:to-postgres && prisma generate && tsc",
    "start:prod": "prisma db push --accept-data-loss && node dist/index.js",
    "sync": "tsx src/sync/run.ts",
    "connector:test": "tsx src/connector/test.ts",
    "discover": "tsx src/connector/discover.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "croner": "^9.0.0",
    "qrcode": "^1.5.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
