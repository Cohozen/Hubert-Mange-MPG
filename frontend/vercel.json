{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REMPLACER-PAR-URL-RAILWAY.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://REMPLACER-PAR-URL-RAILWAY.up.railway.app/auth/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
