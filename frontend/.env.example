# Base URL de l'API backend.
# - En local : laisser VIDE (ou ne pas définir). Le proxy Vite (vite.config.ts) route
#   /api et /auth vers http://localhost:3001 → on reste same-origin.
# - En prod (Vercel, scope Production) : l'URL du sous-domaine API, ex :
#   VITE_API_BASE_URL=https://api.ligue-hubert-mange.fr
# Les variables VITE_* sont injectées AU BUILD → redéployer après changement.
VITE_API_BASE_URL=
